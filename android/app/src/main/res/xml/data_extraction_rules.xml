<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: cloud backup (Google account) and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="YeahBuddy/data.json" />
        <include domain="file" path="YeahBuddy/data-previous.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="YeahBuddy/data.json" />
        <include domain="file" path="YeahBuddy/data-previous.json" />
    </device-transfer>
</data-extraction-rules>
